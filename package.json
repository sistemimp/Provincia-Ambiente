{
  "name": "provincia-ambiente",
  "version": "0.1.0",
  "private": true,
  "description": "Dashboard Electron app for Provincia e Ambiente data transformation",
  "author": "Alex Olivieri",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "node ./node_modules/electron/cli.js .",
    "start": "node ./node_modules/electron/cli.js .",
    "package": "node ./node_modules/electron-builder/cli.js",
    "build": "echo \"Nessuna build renderer richiesta\""
  },
  "dependencies": {
    "mysql2": "^3.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^28.2.3",
    "electron-builder": "^26.7.0"
  },
  "build": {
    "appId": "it.provincia.ambiente.dashboard",
    "productName": "Provincia e Ambiente",
    "files": [
      "src/renderer/**/*",
      "src/img/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "src/img/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false
    }
  }
}
